# Stripe test-mode credentials. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: stable Stripe Price IDs. Inline one-time prices are used if omitted.
STRIPE_PRICE_BRIEF=
STRIPE_PRICE_AUTOPSY=

# Independent random secret used to derive report-access links.
REPORT_TOKEN_SECRET=

# Set to https://reddotaudit.com after the custom domain is connected.
PUBLIC_SITE_URL=

# Required before live Stripe payments are accepted.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@reddotaudit.com

# Comma-separated ChatGPT account emails allowed to open /research.
PRIVATE_RESEARCH_EMAILS=blk911@gmail.com
